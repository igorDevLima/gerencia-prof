{
  "name": "gerencia-prof",
  "version": "1.0.0",
  "description": "Web app gratuito para gestão de professores, matérias e entregas de tarefas mensais (webpack + package-by-feature).",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "dev": "webpack serve --mode development",
    "preview": "node server.js",
    "prepare-app": "npm run build && cordova prepare",
    "android": "npm run build && cordova run android",
    "ios": "npm run build && cordova run ios"
  },
  "keywords": ["professores", "tarefas", "escola", "cordova", "pwa", "webpack"],
  "license": "MIT",
  "browserslist": ["defaults", "not IE 11"],
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.8.1",
    "sass": "^1.71.1",
    "sass-loader": "^14.1.1",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  }
}
