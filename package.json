{
  "name": "gerencia-prof",
  "version": "1.0.0",
  "description": "Web app gratuito para gestão de professores, matérias e entregas de tarefas mensais (webpack + package-by-feature).",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "dev": "webpack serve --mode development",
    "preview": "node server.js",
    "prepare-app": "npm run build && cordova prepare",
    "android": "npm run build && cordova run android",
    "ios": "npm run build && cordova run ios"
  },
  "keywords": [
    "professores",
    "tarefas",
    "escola",
    "cordova",
    "pwa"
  ],
  "license": "MIT",
  "devDependencies": {
    "cordova-android": "^15.0.0",
    "cordova-plugin-webpack": "^1.0.5",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.3"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-webpack": {}
    }
  }
}
